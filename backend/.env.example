NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-webhook-secret
TELEGRAM_WEBHOOK_PATH=telegram/webhook
TELEGRAM_API_BASE_URL=https://api.telegram.org
GOOGLE_VISION_API_KEY=replace-with-google-vision-api-key
OCR_ENGINE_VERSION=google-vision-text-detection-v1
APP_TIMEZONE=Asia/Yangon
DATABASE_URL=postgresql://payment_verification:payment_verification@localhost:5432/payment_verification?schema=public

# Local S3-compatible storage; use R2 variables in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=payment-verification
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

MATCHING_RULE_VERSION=1.0.0
DEFAULT_TOLERANCE_BEFORE_MINUTES=2
DEFAULT_TOLERANCE_AFTER_MINUTES=2

# Configure only when integrations are enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FCM_PROJECT_ID=
SENTRY_DSN=
