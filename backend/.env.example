NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://payment_verification:payment_verification@localhost:5432/payment_verification?schema=public
# Run pnpm setup:local to generate separate random secrets and an admin password.
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
APP_TIMEZONE=Asia/Yangon

# Private local storage is sufficient for the MVP. Back up this directory with the database.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/objects
# Set STORAGE_DRIVER=s3 for a private R2/S3/MinIO bucket; provision the bucket first.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: leave blank to use human-entered receipt details and manual review.
GOOGLE_VISION_API_KEY=
OCR_ENGINE_VERSION=google-vision-document-text-v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org

MATCHING_RULE_VERSION=mvp-review-1
DEFAULT_TOLERANCE_BEFORE_MINUTES=2
DEFAULT_TOLERANCE_AFTER_MINUTES=2
# Test suite creates and drops a unique schema in this database.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_verification_test?schema=public
